{
    "name": "infrangible/m2-free-shipping",
    "description": "Extends Magento's free shipping method: offer it only when the products in the cart have certain attribute values, and optionally hide all other shipping methods when it applies.",
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Shipping",
        "Cart and checkout",
        "free shipping by product attribute",
        "hide other shipping methods when free shipping applies",
        "conditional free shipping"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-free-shipping",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-core": "~2.15.1"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\FreeShipping\\": "src"
        }
    }
}
